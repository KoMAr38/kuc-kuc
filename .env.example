# Copy to .env for local runs. Never put secrets or phone numbers in this file.
# Every setting is read with the prefix KUCKUC_ (see src/kuckuc/config.py).

KUCKUC_PROJECT=your-gcp-project-id
KUCKUC_REGION=europe-west1

# Public URLs of the deployed services (filled in by deploy/deploy.sh).
KUCKUC_VOICE_PUBLIC_URL=
KUCKUC_WEB_PUBLIC_URL=
KUCKUC_ENGINE_URL=

# Model and voices (looked up and recorded at first deploy).
KUCKUC_GEMINI_MODEL=
KUCKUC_TTS_VOICE_SR=
KUCKUC_TTS_VOICE_EN=

# Sections of the site that are live, as a JSON list: ["forecast", "family", "loadtest"]
KUCKUC_FEATURES=[]
