# What is switched on in the deployed site. No secrets here.
# KUCKUC_FEATURES is a JSON list of: "forecast", "family", "loadtest".
# Keep the single quotes: this file is read by the shell, which would otherwise eat the double ones.
# The architecture page shows a section only when its feature is in this list,
# so add a name here only after that part really runs in the cloud.
KUCKUC_FEATURES='["forecast","loadtest","family"]'

# The family page. Both values are public (they appear in the page), not secrets.
# Leave a line commented out until the thing exists.
#   Google sign-in: the "Client ID" of a web client whose authorised JavaScript origin is the site's address.
# KUCKUC_GOOGLE_OAUTH_CLIENT_ID='0000000000-xxxxxxxx.apps.googleusercontent.com'
#   The Telegram bot's username, without the @.
# KUCKUC_TELEGRAM_BOT_NAME='example_bot'
KUCKUC_TELEGRAM_BOT_NAME='kuckuc_javlja_bot'
KUCKUC_GOOGLE_OAUTH_CLIENT_ID='640631568386-p7u1aaae3c8oku1him57jvklc6gm9mi5.apps.googleusercontent.com'
KUCKUC_GITHUB_URL='https://github.com/KoMAr38/kuc-kuc'
